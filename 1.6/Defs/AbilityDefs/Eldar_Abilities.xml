<Defs>

	<AbilityCategoryDef>
		<defName>OG_Eldar</defName>
		<displayOrder>1000</displayOrder>
	</AbilityCategoryDef>
	
	<AbilityDef Name="OG_Eldar_Ability" Abstract="true">
		<category>OG_Eldar</category>
	</AbilityDef>

	<AbilityDef ParentName="OG_Eldar_Ability">
		<defName>OGE_SwoopingHawk_Flight</defName>
		<label>swooping leap</label>
		<description>Jump to a distant location using special hawk jetpack.</description>
		<!--iconPath>UI/Abilities/Tyranid/Gaunt_Leap_Icon</iconPath-->
		<cooldownTicksRange>240</cooldownTicksRange>
		<aiCanUse>true</aiCanUse>
		<hostile>false</hostile>
		<ai_IsIncendiary>false</ai_IsIncendiary>
		<ai_IsOffensive>false</ai_IsOffensive>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>AdeptusMechanicus.Verb_CastAbilityJump</verbClass>
			<label>leap</label>
			<violent>false</violent>
			<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
			<warmupTime>0.1</warmupTime>
			<minRange>3</minRange>
			<range>24</range>
			<requireLineOfSight>true</requireLineOfSight>
			<soundCast>Longjump_Jump</soundCast>
			<soundLanding>Longjump_Land</soundLanding>
			<flyWithCarriedThing>false</flyWithCarriedThing>
			<drawAimPie>false</drawAimPie>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
				<canTargetPawns>false</canTargetPawns>
				<canTargetBuildings>false</canTargetBuildings>
			</targetParams>
		</verbProperties>
	</AbilityDef>

	<AbilityDef ParentName="OG_Eldar_Ability">
		<defName>OGE_WarpSpider_Jump</defName>
		<label>warp teleport</label>
		<description>Teleport to a distant location using special warp field generators built into the armor.</description>
		<!--iconPath>UI/Abilities/Tyranid/Gaunt_Leap_Icon</iconPath-->
		<cooldownTicksRange>480</cooldownTicksRange>
		<aiCanUse>true</aiCanUse>
		<hostile>false</hostile>
		<ai_IsIncendiary>false</ai_IsIncendiary>
		<ai_IsOffensive>false</ai_IsOffensive>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<label>jump</label>
			<violent>false</violent>
			<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
			<warmupTime>0.25</warmupTime>
			<minRange>2</minRange>
			<range>24</range>
			<ai_IsWeapon>false</ai_IsWeapon>
			<requireLineOfSight>false</requireLineOfSight>
			<soundCast>Longjump_Jump</soundCast>
			<soundLanding>Longjump_Land</soundLanding>
			<flyWithCarriedThing>false</flyWithCarriedThing>
			<drawAimPie>false</drawAimPie>
			<targetParams>
				<canTargetSelf>false</canTargetSelf>
				<canTargetLocations>true</canTargetLocations>
				<canTargetPawns>false</canTargetPawns>
				<canTargetBuildings>false</canTargetBuildings>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="CompProperties_AbilityTeleport">
				<compClass>AdeptusMechanicus.CompAbilityEffect_Teleport</compClass>
				<destination>Selected</destination>
				<requiresLineOfSight>false</requiresLineOfSight>
				<range>-1</range>
				<clamorType>Ability</clamorType>
				<clamorRadius>10</clamorRadius>
				<destClamorType>Ability</destClamorType>
				<destClamorRadius>10</destClamorRadius>
				<maxBodySize>10</maxBodySize>
			</li>
		</comps>
	</AbilityDef>
 
