	<AbilityDef ParentName="OG_Eldar_Ability">
		<defName>OGE_Ranger_Invisibility</defName>
		<label>activate camoline</label>
		<description>Chameleonic skin is a Tyranid biomorph used as camouflage by Lictors to continuously change their skin colour to blend into any environment and become all but invisible to the naked eye.</description>
		<!--iconPath>UI/Abilities/XV25StealthSuit_Icon</iconPath-->
		<cooldownTicksRange>6000</cooldownTicksRange> <!-- 2 hours -->
		<aiCanUse>true</aiCanUse>
		<writeCombatLog>True</writeCombatLog>
		<hotKey>Misc12</hotKey>
		<targetRequired>false</targetRequired>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<statBases>
			<Ability_Duration>60</Ability_Duration>
		</statBases>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<drawAimPie>false</drawAimPie>
			<requireLineOfSight>false</requireLineOfSight>
			<nonInterruptingSelfCast>true</nonInterruptingSelfCast>
			<warmupTime>0.5</warmupTime>
			<range>19.9</range>
			<targetable>false</targetable>
			<targetParams>
				<canTargetSelf>True</canTargetSelf>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="CompProperties_AbilityGiveHediff">
				<compClass>CompAbilityEffect_GiveHediff</compClass>
				<hediffDef>OGE_Ranger_Invisibility</hediffDef>
				<psychic>false</psychic>
			</li>
		</comps>
	</AbilityDef>
	<HediffDef>
		<defName>OGE_Ranger_Invisibility</defName>
		<label>invisibility</label>
		<hediffClass>HediffWithComps</hediffClass>
		<description>Chameleonic skin is a Tyranid biomorph used as camouflage by Lictors to continuously change their skin colour to blend into any environment and become all but invisible to the naked eye.</description>
		<isBad>false</isBad>
		<comps>
			<li Class="HediffCompProperties_Invisibility">
				<visibleToPlayer>false</visibleToPlayer>
				<fadeDurationTicks>120</fadeDurationTicks>
			</li>
			<li Class="HediffCompProperties_Disappears">
				<showRemainingTime>True</showRemainingTime>
			</li>
			<li Class="HediffCompProperties_DisappearsOnDeath"/>
		</comps>
	</HediffDef>

