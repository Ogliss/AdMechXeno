<!-- Biomorph_FleshHooks-->
<!-- Negates terrain movement penalty, Ranged attack that stuns pawns slightly, 
ideally would pull them to the caster, or the caster to them if the targets larger-->
	<HediffDef ParentName="Tyranidbiomorph">
		<defName>OG_Tyranid_Biomorph_FleshHooks</defName>
		<label>flesh hooks</label>
		<labelNoun>a Flesh hooks biomorph</labelNoun>
		<stages>
			<li>
				<label>ranged attack, move through cover</label>
			</li>
		</stages>
		<comps>
			<li Class="AdeptusMechanicus.HediffCompProperties_VerbGiverExtra">
				<verbEntrys>
					<li>
						<Multishot>true</Multishot>
						<ScattershotCount>4</ScattershotCount>
						<VerbProps>
							<verbClass>Verb_Shoot</verbClass>
							<label>flesh hooks</label>
							<accuracyTouch>0.15</accuracyTouch>
							<accuracyShort>0.45</accuracyShort>
							<accuracyMedium>0.15</accuracyMedium>
							<accuracyLong>0.1</accuracyLong>
							<hasStandardCommand>true</hasStandardCommand>
							<defaultProjectile>OGTY_Bullet_FleshHooks</defaultProjectile>
							<warmupTime>0.5</warmupTime>
							<range>12</range>
							<ticksBetweenBurstShots>6</ticksBetweenBurstShots>
							<burstShotCount>1</burstShotCount>
							<soundCast>OG_Fleshhook_Sound</soundCast>
							<soundCastTail>GunTail_Light</soundCastTail>
							<muzzleFlashScale>0</muzzleFlashScale>
							<targetParams>
								<canTargetLocations>true</canTargetLocations>
							</targetParams>
							<commonality>0.25</commonality>
						</VerbProps>
					</li>
				</verbEntrys>
			</li>
			<li Class="AdeptusMechanicus.HediffCompProperties_MoveThroughCover">
				<MoveThroughAll>true</MoveThroughAll>
				<!--
				<TerrainTagsList>
					<li></li> 
				</TerrainTagsList>
				<BuildingClassList>
					<li></li> 
				</BuildingClassList> 
				-->
			</li>
		</comps>
	</HediffDef>

