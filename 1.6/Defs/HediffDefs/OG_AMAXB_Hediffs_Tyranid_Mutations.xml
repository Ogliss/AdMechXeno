<!-- WeaponSymbiote_RendingClaw-->
<!-- rending attacks -->
	<HediffDef ParentName="TyranidWeaponSymbiote">
		<defName>OG_Tyranid_Symbiote_RendingClaw</defName>
		<label>rending claw</label>
		<labelNoun>a rending claw</labelNoun>
		<comps>
			<li Class="HediffCompProperties_VerbGiver">
				<tools>
					<li>
						<label>rending claws</label>
						<capacities>
							<li>OG_RendingWeapon_Cut</li>
							<li>OG_RendingWeapon_Stab</li>
						</capacities>
						<power>18.0</power>
						<cooldownTime>2</cooldownTime>
						<alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
					</li>
				</tools>
			</li>
		</comps>
		<!--<spawnThingOnRemoved>PowerClaw</spawnThingOnRemoved>-->
		<addedPartProps>
			<isGoodWeapon>true</isGoodWeapon>
			<solid>true</solid>
			<partEfficiency>1.25</partEfficiency>
		</addedPartProps>
	</HediffDef>

