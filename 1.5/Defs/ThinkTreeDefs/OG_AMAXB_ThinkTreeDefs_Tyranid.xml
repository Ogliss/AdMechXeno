<!-- ThinkNode_ConditionalIsMemberOfRace -->
	<ThinkTreeDef>
		<defName>OG_Tyranid_Constant</defName>
		<thinkRoot Class="ThinkNode_Priority">
			<subNodes>

				<!-- Despawned -->
				<li Class="ThinkNode_Subtree">
					<treeDef>Despawned</treeDef>
				</li>

				<!-- Jump towards target to Attack in Melee -->
				<li Class="ThinkNode_ConditionalDoingJob">
					<jobDef>AttackMelee</jobDef>
					<subNodes>
						<li Class="ThinkNode_ConditionalHasAbility">
							<ability>OGTY_Biomorph_EnhancedLegMuscles_Leap</ability>
							<subNodes>
								<li Class="JobGiver_AIJumpToJobTarget">
									<ability>OGTY_Biomorph_EnhancedLegMuscles_Leap</ability>
								</li>
							</subNodes>
						</li>
						<li Class="ThinkNode_ConditionalHasAbility">
							<ability>OGTY_Biomorph_Wings_Flight</ability>
							<subNodes>
								<li Class="JobGiver_AIJumpToJobTarget">
									<ability>OGTY_Biomorph_Wings_Flight</ability>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>
				<li Class="ThinkNode_ConditionalDoingJob">
					<jobDef>AttackMelee</jobDef>
					<invert>true</invert>
					<subNodes>
						<li Class="ThinkNode_ConditionalHasAbility">
							<ability>OGTY_Biomorph_Wings_Flight</ability>
							<subNodes>
								<li Class="ThinkNode_HarmedRecently">
									<thresholdTicks>120</thresholdTicks>
									<subNodes>
										<li Class="ThinkNode_ConditionalUnderCombatPressure">
											<maxThreatDistance>2</maxThreatDistance>
											<minCloseTargets>2</minCloseTargets>
											<subNodes>
												<li Class="JobGiver_AIJumpEscapeEnemies">
													<ability>OGTY_Biomorph_Wings_Flight</ability>
												</li>
											</subNodes>
										</li>
									</subNodes>
								</li>
								<li Class="AdeptusMechanicus.JobGiver_AIJumpToShootingPosition">
									<ability>OGTY_Biomorph_Wings_Flight</ability>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>
			
				<!-- Jump Away from hostiles in Melee -->
				<!--li Class="ThinkNode_ConditionalHasAbility">
					<ability>OGTY_Biomorph_Wings_Flight</ability>
					<subNodes>
						<li Class="ThinkNode_ConditionalTotalDamage">
							<thresholdPercent>0.25</thresholdPercent>
							<subNodes>
								<li Class="ThinkNode_HarmedRecently">
									<thresholdTicks>120</thresholdTicks>
									<subNodes>
										<li Class="ThinkNode_ConditionalUnderCombatPressure">
											<maxThreatDistance>2</maxThreatDistance>
											<minCloseTargets>2</minCloseTargets>
											<subNodes>
												<li Class="JobGiver_AIJumpEscapeEnemies">
													<ability>OGTY_Biomorph_Wings_Flight</ability>
												</li>
											</subNodes>
										</li>
									</subNodes>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li-->
				<li Class="ThinkNode_ConditionalCanDoLordJobNow">
					<subNodes>
						<!-- Lord directives -->
						<li Class="ThinkNode_Subtree">
							<treeDef>LordDutyConstant</treeDef>
						</li>
					</subNodes>
				</li>
				
			</subNodes>
		</thinkRoot>
	</ThinkTreeDef>

</Defs>
